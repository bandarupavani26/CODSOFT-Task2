</p>
        

      </div>

    </div>

  </section>

  <!-- SERVICES -->

  <section class="services" id="services">

    <h2 class="title">My Services</h2>

    <div class="box-container">

      <div class="card">
        <h3>Web Design</h3>
        <p>
          Creating attractive and modern website layouts.
        </p>
      </div>

      <div class="card">
        <h3>Responsive Design</h3>
        <p>
          Designing websites that work on all devices.
        </p>
      </div>

      <div class="card">
        <h3>Frontend Development</h3>
        <p>
          Building user-friendly and clean web pages.
        </p>
      </div>

    </div>

  </section>

  <!-- SKILLS -->

  <section class="skills" id="skills">

    <h2 class="title">My Skills</h2>

    <div class="box-container">

      <div class="card">
        <h3>HTML</h3>
        <p>
          Creating webpage structures using HTML5.
        </p>
      </div>

      <div class="card">
        <h3>CSS</h3>
        <p>
          Styling beautiful and responsive web pages.
        </p>
      </div>

      <div class="card">
        <h3>Responsive Design</h3>
        <p>
          Making websites mobile friendly.
        </p>
      </div>

    </div>

  </section>

  <!-- PROJECTS -->

  <section class="projects" id="projects">

    <h2 class="title">Projects</h2>

    <div class="box-container">

      <div class="card">
        <h3>Landing Page</h3>
        <p>
          Responsive landing page using HTML and CSS.
        </p>
      </div>

      <div class="card">
        <h3>Portfolio Website</h3>
        <p>
          Personal portfolio website project.
        </p>
      </div>

    </div>

  </section>

  <!-- CONTACT -->

  <section class="contact" id="contact">

    <h2 class="title">Contact Me</h2>

    <div class="box-container">

      <div class="card">
        <h3>Email</h3>
        <p>pavani@gmail.com</p>
      </div>

      <div class="card">
        <h3>Phone</h3>
        <p>+91 9876543210</p>
      </div>

      <div class="card">
        <h3>Location</h3>
        <p>India</p>
      </div>

    </div>

  </section>

  <!-- FOOTER -->

  <footer>

    <p>
      © 2026 Pavani Landing Page | Designed using HTML & CSS
    </p>

  </footer>

</body>
</html>
